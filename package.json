{
  "name": "video-segment-annotation",
  "version": "1.0.0",
  "private": true,
  "description": "多租户视频片段标注平台",
  "scripts": {
    "predev": "node scripts/setup.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/setup.mjs",
    "build": "next build",
    "start": "next start",
    "db:reset": "node scripts/setup.mjs --reset",
    "db:check": "node scripts/check-invariants.mjs",
    "db:verify-checker": "node scripts/verify-checker.mjs",
    "invariant:check": "node scripts/invariant-check.mjs",
    "audit:rules": "node scripts/audit-rules.mjs",
    "audit:sql": "node scripts/audit-sql.mjs",
    "lint": "eslint .",
    "pretest": "node scripts/audit-rules.mjs && node scripts/audit-sql.mjs && eslint . --quiet && node scripts/invariant-check.mjs --temp",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser/run.mjs",
    "verify": "npm test && npm run test:browser"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
